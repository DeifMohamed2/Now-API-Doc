  "keyFeatures": [
    "Merchant sub-account onboarding in a single API call",
    "Multi-tenant company integrator model with X-Merchant-Id header",
    "Server-side fee computation (never send fees in requests)",
    "Delivery zone catalog with ETag caching",
    "Order types: Deliver, Return, Exchange",
    "AWB (shipping label) PDF download in A4 or A5",
    "Pickup scheduling and fee preview",
    "API key scopes (orders, pickups, merchants)",
    "Rate limiting: 120 req/min per key",
    "Coverage: Cairo, Giza, Qalyubia governorates"
  ],
  "publicApiSurface": [
    "GET /ping",
    "GET /delivery-zones",
    "POST /fees/calculate",
    "POST /merchants",
    "GET /merchants",
    "GET /merchants/{merchantId}",
    "POST /orders",
    "GET /orders",
    "GET /orders/{orderNumber}",
    "PUT /orders/{orderId}",
    "POST /orders/{orderId}/cancel",
    "DELETE /orders/{orderId}",
    "GET /orders/{orderNumber}/awb",
    "POST /pickups/calculate-fee",
    "POST /pickups",
    "GET /pickups",
    "GET /pickups/{pickupNumber}",
    "PUT /pickups/{pickupNumber}",
    "POST /pickups/{pickupNumber}/cancel",
    "DELETE /pickups/{pickupNumber}"
  ]
